# Copy to .env and restart the server after changing a value.
ENABLE_SPANISH=false
ENABLE_JAPANESE=false
CONVERT_TO_MXN=true
# Optional: pokemontcg.io API key (https://dev.pokemontcg.io) for higher rate limits on the backup price source.
POKEMONTCG_API_KEY=
# Banxico SIE token (https://www.banxico.org.mx/SieAPIRest/service/v1/token); needed when CONVERT_TO_MXN=true.
BANXICO_TOKEN=
